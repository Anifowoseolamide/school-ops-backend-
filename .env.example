# Copy to .env and adjust. Real environment variables override this file.

# --- Django -------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Lagos

# --- Database ------------------------------------------------------------
# sqlite (default) or postgres
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
# DB_NAME=schoolops
# DB_USER=schoolops
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Frontend / links ---------------------------------------------------
# Where the frontend runs (used in pay links and password reset emails)
FRONTEND_URL=http://localhost:3000
# Where this API runs (used in receipt and report card PDF links)
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth ---------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Paystack -----------------------------------------------------------
# Test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# The frontend page Paystack redirects to after checkout
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/complete
# Development only: complete "online" payments without Paystack keys (ignored when DEBUG=false)
PAYSTACK_SIMULATE=true

# --- Email and SMS --------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@schoolops.local
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
SMS_BACKEND=apps.notifications.backends.ConsoleSMSBackend

# --- Links lifetime (days) -----------------------------------------------
PAY_LINK_MAX_AGE_DAYS=30
RECEIPT_LINK_MAX_AGE_DAYS=180
REPORT_CARD_LINK_MAX_AGE_DAYS=14
